<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LibRangeMap</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LibRangeMap</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\\..\\..\\librangemap\\native\\librangemap_core.dll" CopyToOutputDirectory="PreserveNewest" Link="librangemap_core.dll" />
  </ItemGroup>
</Project>
